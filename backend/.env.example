# Credenciales PostgreSQL
POSTGRES_USER=mentormatch_user
POSTGRES_PASSWORD=mentormatch_pass
POSTGRES_DB=mentormatch
POSTGRES_PORT=5432
POSTGRES_HOST=db

# Para desarrollo local sin Docker, cambia POSTGRES_HOST a 127.0.0.1
# DATABASE_URL se construye con el host correcto segun el contexto
DATABASE_URL=postgresql+asyncpg://mentormatch_user:mentormatch_pass@db:5432/mentormatch

# JWT — genera con: openssl rand -hex 32
SECRET_KEY=una_clave_secreta_muy_larga_y_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ENVIRONMENT=development