# URL del backend de FastAPI
VITE_BACKEND_URL=http://localhost:8000

# --- FLAG DE DESARROLLO ---
# En true: habilita el boton "Iniciar ahora" en el frontend sin esperar la hora de la sesion
# Poner false en produccion real
VITE_DEV_MODE=true

# Endpoint de monitoreo (opcional, si no se configura los logs van a consola)
# VITE_MONITORING_ENDPOINT=
